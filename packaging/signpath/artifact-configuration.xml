<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for the release workflow.
  actions/upload-artifact always delivers a zip, which contains the single-file LayoutLock.exe.
  Paste this into SignPath: Project "LayoutLock" -> Artifact configurations -> Edit.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="LayoutLock.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
